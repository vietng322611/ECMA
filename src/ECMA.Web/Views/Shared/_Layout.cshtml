<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - ECMA</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true"/>
</head>
<body>
<header class="border-b border-stone-200 bg-white">
    <nav class="flex h-16 items-center justify-between px-5 sm:px-8" aria-label="Điều hướng chính">
        <div class="flex min-w-0 items-center gap-7">
            <a class="shrink-0 text-2xl font-black tracking-tight text-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700" asp-area="" asp-controller="Home" asp-action="Index">ECMA</a>
            <a class="truncate text-sm font-semibold text-stone-600 transition hover:text-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700" asp-area="" asp-controller="Home" asp-action="Index">Tra cứu sự kiện</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="truncate text-sm font-semibold text-stone-600 transition hover:text-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700" asp-controller="PublicEvents" asp-action="MyRegistrations">Đăng ký của tôi</a>
            }
            @if (User.IsInRole("Organizer") || User.IsInRole("Admin"))
            {
                <a class="truncate text-sm font-semibold text-stone-600 transition hover:text-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700" asp-controller="Events" asp-action="Index">Quản lý sự kiện</a>
            }
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name ?? "Tài khoản";
            <details class="group relative shrink-0">
                <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-stone-300 bg-stone-100 px-2 py-1.5 text-sm font-semibold text-stone-700 transition hover:border-stone-400 hover:bg-stone-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 [&::-webkit-details-marker]:hidden">
                    <span class="flex size-8 items-center justify-center rounded-full bg-emerald-100 font-bold text-emerald-700">@displayName[..1].ToUpperInvariant()</span>
                    <span class="hidden max-w-40 truncate sm:block">@displayName</span>
                    <span class="text-xs text-stone-400 transition group-open:rotate-180" aria-hidden="true">▼</span>
                </summary>
                <div class="absolute right-0 top-[calc(100%+0.5rem)] z-50 min-w-48 rounded-xl border border-stone-200 bg-white p-1.5 shadow-[0_8px_30px_rgba(0,0,0,0.12)]">
                    <a class="flex items-center gap-2 rounded-md px-3 py-2.5 text-sm font-medium text-emerald-700 transition hover:bg-stone-50 focus-visible:outline-2 focus-visible:outline-emerald-700" asp-controller="Account" asp-action="Profile">
                        <span aria-hidden="true">●</span>
                        Hồ sơ cá nhân
                    </a>
                    <div class="my-1 border-t border-stone-100"></div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="flex w-full items-center gap-2 rounded-md px-3 py-2.5 text-sm font-medium text-red-600 transition hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-red-600" type="submit">
                            <span aria-hidden="true">↪</span>
                            Đăng xuất
                        </button>
                    </form>
                </div>
            </details>
        }
        else
        {
            <a class="shrink-0 rounded-lg bg-emerald-700 px-4 py-2 text-sm font-bold text-white transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 active:translate-y-px" asp-controller="Account" asp-action="Login">Đăng nhập</a>
        }
    </nav>
</header>
<main id="noi-dung-chinh" class="min-h-[calc(100dvh-4rem)]">
    @RenderBody()
</main>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>